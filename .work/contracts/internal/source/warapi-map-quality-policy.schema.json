{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:foxdata:contract:source:warapi-map-quality-policy",
  "title": "FoxData Official War API map quality policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "taxonomyVersion",
    "reviewedAt",
    "aggregation",
    "rules"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "warapi-map-quality@1",
        "warapi-map-quality@2"
      ]
    },
    "source": {
      "const": "official-war-api"
    },
    "taxonomyVersion": {
      "type": "string",
      "pattern": "^warapi-map-taxonomy@[1-9][0-9]*$"
    },
    "reviewedAt": {
      "type": "string",
      "format": "date"
    },
    "aggregation": {
      "$ref": "#/$defs/aggregation"
    },
    "rules": {
      "type": "array",
      "minItems": 8,
      "maxItems": 15,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/regionIdValidRule"
          },
          {
            "$ref": "#/$defs/regionIdConflictRule"
          },
          {
            "$ref": "#/$defs/coordinateValidRule"
          },
          {
            "$ref": "#/$defs/sourceTimeRepresentableRule"
          },
          {
            "$ref": "#/$defs/structureChangedRule"
          },
          {
            "$ref": "#/$defs/unknownIconRule"
          },
          {
            "$ref": "#/$defs/unknownTeamRule"
          },
          {
            "$ref": "#/$defs/unknownFlagBitsRule"
          },
          {
            "$ref": "#/$defs/sourceVersionRegressionRule"
          },
          {
            "$ref": "#/$defs/sourceVersionGapRule"
          },
          {
            "$ref": "#/$defs/sourceLastUpdatedRegressionRule"
          },
          {
            "$ref": "#/$defs/nearEmptyRule"
          },
          {
            "$ref": "#/$defs/massDisappearanceRule"
          },
          {
            "$ref": "#/$defs/duplicateOccurrenceRule"
          },
          {
            "$ref": "#/$defs/restartCollapseRule"
          }
        ]
      }
    }
  },
  "$defs": {
    "aggregation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noFindingsDecision",
        "informationalDecision",
        "suspectDecision",
        "quarantinedDecision"
      ],
      "properties": {
        "noFindingsDecision": {
          "const": "accepted"
        },
        "informationalDecision": {
          "const": "accepted"
        },
        "suspectDecision": {
          "const": "suspect"
        },
        "quarantinedDecision": {
          "const": "quarantined"
        }
      }
    },
    "baseRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "ruleVersion",
        "configurationVersion",
        "effect",
        "parameters"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "ruleVersion": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*@[1-9][0-9]*$"
        },
        "configurationVersion": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*-config@[1-9][0-9]*$"
        },
        "effect": {
          "enum": [
            "informational",
            "suspect",
            "quarantined"
          ]
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "regionIdValidRule": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRule"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "const": "region-id.valid"
            },
            "effect": {
              "const": "quarantined"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "allowNull",
                "minimum"
              ],
              "properties": {
                "allowNull": {
                  "const": true
                },
                "minimum": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      ]
    },
    "regionIdConflictRule": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRule"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "const": "region-id.conflict"
            },
            "effect": {
              "const": "quarantined"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "blockOnConflict"
              ],
              "properties": {
                "blockOnConflict": {
                  "const": true
                }
              }
            }
          }
        }
      ]
    },
    "coordinateValidRule": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRule"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "const": "coordinate.valid"
            },
            "effect": {
              "const": "quarantined"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minimum",
                "maximum",
                "requireFinite"
              ],
              "properties": {
                "minimum": {
                  "type": "number",
                  "const": 0
                },
                "maximum": {
                  "type": "number",
                  "const": 1
                },
                "requireFinite": {
                  "const": true
                }
              }
            }
          }
        }
      ]
    },
    "sourceTimeRepresentableRule": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRule"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "const": "source-time.representable"
            },
            "effect": {
              "const": "suspect"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "allowMissing",
                "requireSafeUtcWhenPresent"
              ],
              "properties": {
                "allowMissing": {
                  "const": true
                },
                "requireSafeUtcWhenPresent": {
                  "const": true
                }
              }
            }
          }
        }
      ]
    },
    "structureChangedRule": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRule"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "const": "schema.structure-changed"
            },
            "effect": {
              "const": "informational"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "maxProperties": 0
            }
          }
        }
      ]
    },
    "unknownIconRule": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRule"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "const": "taxonomy.unknown-icon"
            },
            "effect": {
              "const": "informational"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "maxProperties": 0
            }
          }
        }
      ]
    },
    "unknownTeamRule": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRule"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "const": "taxonomy.unknown-team"
            },
            "effect": {
              "const": "informational"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "maxProperties": 0
            }
          }
        }
      ]
    },
    "unknownFlagBitsRule": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRule"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "const": "taxonomy.unknown-flag-bits"
            },
            "effect": {
              "const": "informational"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "maxProperties": 0
            }
          }
        }
      ]
    },
    "sourceVersionRegressionRule": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRule"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "const": "source-version.regression"
            },
            "effect": {
              "const": "informational"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "triggerBelowDelta"
              ],
              "properties": {
                "triggerBelowDelta": {
                  "type": "number",
                  "maximum": 0
                }
              }
            }
          }
        }
      ]
    },
    "sourceVersionGapRule": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRule"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "const": "source-version.gap"
            },
            "effect": {
              "const": "informational"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minimumMissingVersions"
              ],
              "properties": {
                "minimumMissingVersions": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      ]
    },
    "sourceLastUpdatedRegressionRule": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRule"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "const": "source-last-updated.regression"
            },
            "effect": {
              "const": "suspect"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "triggerBelowDeltaMilliseconds"
              ],
              "properties": {
                "triggerBelowDeltaMilliseconds": {
                  "type": "number",
                  "maximum": 0
                }
              }
            }
          }
        }
      ]
    },
    "nearEmptyRule": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRule"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "const": "representation.near-empty"
            },
            "effect": {
              "const": "suspect"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minimumBaselineOccurrences",
                "maximumTotalOccurrenceRatio"
              ],
              "properties": {
                "minimumBaselineOccurrences": {
                  "type": "integer",
                  "minimum": 1
                },
                "maximumTotalOccurrenceRatio": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      ]
    },
    "massDisappearanceRule": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRule"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "const": "representation.mass-disappearance"
            },
            "effect": {
              "const": "suspect"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minimumBaselineItems",
                "maximumItemCountRatio"
              ],
              "properties": {
                "minimumBaselineItems": {
                  "type": "integer",
                  "minimum": 1
                },
                "maximumItemCountRatio": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      ]
    },
    "duplicateOccurrenceRule": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRule"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "const": "representation.duplicate-occurrence"
            },
            "effect": {
              "const": "informational"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minimumExcessCount"
              ],
              "properties": {
                "minimumExcessCount": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      ]
    },
    "restartCollapseRule": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRule"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "const": "ownership.restart-collapse"
            },
            "effect": {
              "const": "quarantined"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minimumBaselineItems",
                "minimumBaselineOwnedShare",
                "minimumCurrentNoneShare",
                "minimumNoneShareIncrease",
                "maximumCurrentOwnedShare",
                "minimumOwnedShareDrop",
                "maximumItemCountRatio",
                "maximumDistinctIconTypeRatio",
                "minimumCorroboratingSignals",
                "versionRegressionCountsAsCorroboratingSignal"
              ],
              "properties": {
                "minimumBaselineItems": {
                  "type": "integer",
                  "minimum": 1
                },
                "minimumBaselineOwnedShare": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minimumCurrentNoneShare": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minimumNoneShareIncrease": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "maximumCurrentOwnedShare": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minimumOwnedShareDrop": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "maximumItemCountRatio": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "maximumDistinctIconTypeRatio": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "minimumCorroboratingSignals": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                },
                "versionRegressionCountsAsCorroboratingSignal": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      ]
    }
  }
}
